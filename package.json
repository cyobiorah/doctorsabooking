{
  "name": "doctorsa-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "node dist/seed.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" public/style.css README.md"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.2.6",
    "typescript": "5.8.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
